# ─── Database ──────────────────────────────────────────────
# Runtime connection (used by Prisma Client via PrismaPg adapter).
# Supabase: use the Transaction Pooler URL (port 6543, ?pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Migration / direct connection (used by `prisma migrate deploy`).
# Supabase: use the Session/Direct URL (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── NextAuth v5 ───────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST="true"
# Required on Vercel — set to your production URL (e.g. https://mahasewa.vercel.app)
AUTH_URL="http://localhost:3000"

# ─── Supabase (storage / public) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ─── Container behaviour ───────────────────────────────────
# Set false to skip `migrate deploy` on container start.
RUN_MIGRATIONS="true"
